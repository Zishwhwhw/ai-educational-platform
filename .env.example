# Скопируй в .env и заполни. Файл .env в git не попадает.

# Обязательно. Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Пароль Postgres для локальной разработки.
POSTGRES_PASSWORD=devpassword

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Заполняются на своих фазах, пока не используются:
# ANTHROPIC_API_KEY=
# YOUTUBE_API_KEY=
# PISTON_URL=
# STRIPE_SECRET_KEY=
# SENTRY_DSN=
